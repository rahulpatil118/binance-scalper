# ============================================================
#  .env.example — copy to .env and fill in. NEVER commit real .env.
#  Deribit BTC options bot (deribit/ — weekly cash-secured PUT seller)
# ============================================================

# API credentials (Deribit -> Account -> API -> add OAuth2 key)
# Testnet keys: https://test.deribit.com   |   Live keys: https://www.deribit.com
DERIBIT_CLIENT_ID=your_deribit_client_id_here
DERIBIT_CLIENT_SECRET=your_deribit_client_secret_here

# 1 = test.deribit.com (safe), 0 = live trading (real money, CAUTION!)
DERIBIT_TESTNET=1

# Strategy tuning
OTM_PCT=0.05          # put strike % below index (0.05 = 5% OTM)
DTE_MIN=5             # minimum days to expiry when picking the put
CONTRACTS=0.1         # BTC per trade (Deribit min 0.1)
TP_PCT=0.5            # buy back at 50% of collected premium
SPREAD=0              # 1 = buy a further-OTM wing (defined-risk credit spread)
SPREAD_WIDTH=0.05     # wing distance below short strike (when SPREAD=1)
POLL_SECONDS=60       # engine loop interval
TRADING_ENABLED=1     # 0 = signals only (no orders placed)

# Dashboard port
WEB_PORT=5001
